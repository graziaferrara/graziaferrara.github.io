<div class="news">
  {% if site.news != blank %}
    {% assign news_size = site.news | size %}
    <div
      class="news-wrapper {% if include.limit and page.announcements.scrollable and news_size > 3 %}scrollable{% endif %}"
      {% if include.limit and page.announcements.scrollable and news_size > 3 and page.announcements.max_height %}
        style="--news-max-height: {{ page.announcements.max_height }};"
      {% endif %}
    >
      <div class="news-list">
        {% assign news = site.news | reverse %}
        {% if include.limit and page.announcements.limit %}
          {% assign news_limit = page.announcements.limit %}
        {% else %}
          {% assign news_limit = news_size %}
        {% endif %}
        {% for item in news limit: news_limit %}
          <div class="news-entry">
            <div class="news-date">
              <span class="date-badge">{{ item.date | date: '%b %d, %Y' }}</span>
            </div>
            <div class="news-content">
              {%- if item.inline -%}
                {{- item.content | remove: '<p>' | remove: '</p>' | emojify -}}
              {%- else -%}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {%- endif -%}
            </div>
          </div>
        {% endfor %}
      </div>
    </div>
  {% else %}
    <p>No news so far...</p>
  {% endif %}
</div>
